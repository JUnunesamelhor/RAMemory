      padding: 30px;
      text-align: center;
      text-shadow: 0 0 8px #000;
    }
    header h1 {
      margin: 0;
      font-size: 3em;
      font-weight: bold;
      letter-spacing: 2px;
    }
    header p {
      margin: 5px 0 0;
      font-style: italic;
      font-size: 1.2em;
    }

    /* Menu gamer */
    nav {
      background: #1a1a1a;
      padding: 15px;
      text-align: center;
      border-bottom: 2px solid #00ff99;
